{
  "name": "electronics-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Electronics training app: leveled lessons, quizzes, test-outs, circuit simulator, team progress and weekly reports.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "seed": "node scripts/seed.js --reset",
    "report": "node scripts/weekly-report.js --out reports/weekly-report.html",
    "test": "node tests/solver.test.js && node tests/content.test.js && node tests/api.test.js",
    "test:browser": "node tests/e2e.js && node tests/mobile.js",
    "admin-invite": "node scripts/admin-invite.js",
    "backup-db": "node scripts/backup-db.js"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
